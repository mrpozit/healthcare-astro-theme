---
import nav from "../data/navigation.json";

const socialLinks = [
  { label: "Instagram", href: "https://www.instagram.com/snp.consult", icon: "instagram" },
  { label: "Telegram", href: "https://t.me/Patris_life", icon: "telegram" },
  { label: "YouTube", href: "https://youtube.com/@patris_life", icon: "youtube" },
  { label: "Substack", href: "https://brannsolenua.substack.com/", icon: "substack" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/icra-centre", icon: "linkedin" },
];
---

<footer class="icra-footer">
  <div class="icra-container">
    <div class="icra-footer__main">
      <div class="icra-footer__identity">
        <p class="icra-footer__name">Міжнародний центр відновлення і адаптації</p>
        <p class="icra-footer__name-en">International Center for Recovery and Adaptation</p>
        <p class="icra-footer__tagline">Простір, який уже існував до того, як отримав назву.</p>
      </div>

      <nav class="icra-footer__navigation" aria-label="Навігація у футері">
        {nav.links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={nav.cta.href}>{nav.cta.label}</a>
      </nav>

      <div class="icra-footer__socials" aria-label="ICRA у соціальних мережах">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" class="icra-footer__social-link">
            <span class="icra-footer__social-icon" aria-hidden="true">
              {social.icon === "instagram" && <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="fill-current"/></svg>}
              {social.icon === "telegram" && <svg viewBox="0 0 24 24"><path d="m3 11 17-7-4 16-5-5-3 3v-5z"/><path d="m8 13 8-6"/></svg>}
              {social.icon === "youtube" && <svg viewBox="0 0 24 24"><path d="M21 12s0-4-1-5-3-1-8-1-7 0-8 1-1 5-1 5 0 4 1 5 3 1 8 1 7 0 8-1 1-5 1-5z"/><path d="m10 9 5 3-5 3z"/></svg>}
              {social.icon === "substack" && <svg viewBox="0 0 24 24"><path d="M5 5h14M5 9h14M7 13h10v7l-5-3-5 3z"/></svg>}
              {social.icon === "linkedin" && <svg viewBox="0 0 24 24"><path d="M6 9v10M6 5.5v.01M10.5 19v-6a4 4 0 0 1 8 0v6M10.5 10v9"/></svg>}
            </span>
            <span>{social.label}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="icra-footer__bottom">
      <span>© ICRA 2026. Усі права захищені.</span>
    </div>
  </div>
</footer>
