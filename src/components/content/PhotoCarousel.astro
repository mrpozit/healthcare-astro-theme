---
import { Image } from "astro:assets";

interface PhotoItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: PhotoItem[];
  ariaLabel?: string;
  emptyText?: string;
}

const {
  images,
  ariaLabel = "Фотогалерея",
  emptyText = "Фотографії будуть додані сюди після підготовки до публікації.",
} = Astro.props;
---

<div class="photo-carousel" data-photo-carousel>
  {images.length > 0 ? (
    <>
      <div class="mb-6 flex justify-end gap-3" aria-label="Керування галереєю">
        <button type="button" data-carousel-prev class="grid h-12 w-12 place-items-center rounded-full border border-theme-border bg-theme-surface text-2xl text-theme-primary transition hover:border-theme-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-theme-primary" aria-label="Попередні фото">‹</button>
        <button type="button" data-carousel-next class="grid h-12 w-12 place-items-center rounded-full border border-theme-border bg-theme-surface text-2xl text-theme-primary transition hover:border-theme-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-theme-primary" aria-label="Наступні фото">›</button>
      </div>
      <div data-carousel-track class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" tabindex="0" aria-label={ariaLabel}>
        {images.map((image) => (
          <figure data-carousel-slide class="w-[84%] sm:w-[48%] lg:w-[32%] shrink-0 snap-start overflow-hidden rounded-2xl bg-theme-surface shadow-lg">
            <Image src={image.src} alt={image.alt} class="block w-full aspect-[4/5] object-cover" widths={[480, 720, 960]} sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 84vw" loading="lazy" />
          </figure>
        ))}
      </div>
      <p class="mt-5 text-sm text-theme-text-muted">Гортайте фото стрілками або свайпом.</p>
    </>
  ) : (
    <div class="rounded-2xl border border-dashed border-theme-border-medium bg-theme-surface/60 px-6 py-10 text-theme-text-secondary">
      <p>{emptyText}</p>
    </div>
  )}
</div>

<script is:inline>
  (() => {
    const initPhotoCarousels = () => {
      document.querySelectorAll('[data-photo-carousel]').forEach((carousel) => {
        if (carousel.dataset.ready === 'true') return;
        const track = carousel.querySelector('[data-carousel-track]');
        const prev = carousel.querySelector('[data-carousel-prev]');
        const next = carousel.querySelector('[data-carousel-next]');
        if (!track || !prev || !next) return;
        carousel.dataset.ready = 'true';
        const step = () => {
          const slide = track.querySelector('[data-carousel-slide]');
          if (!slide) return track.clientWidth;
          const gap = parseFloat(getComputedStyle(track).gap || '0');
          return slide.getBoundingClientRect().width + gap;
        };
        prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
        next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      });
    };
    initPhotoCarousels();
    document.addEventListener('astro:page-load', initPhotoCarousels);
  })();
</script>
