---
interface Props {
  items: string[];
  ariaLabel?: string;
}

const { items, ariaLabel = "Процес" } = Astro.props;
---

<ol
  class="flex flex-col gap-3 md:flex-row md:flex-wrap md:items-center"
  aria-label={ariaLabel}
>
  {
    items.map((item, index) => (
      <li class="flex items-center gap-3">
        <span class="rounded-full border border-theme-border bg-theme-surface px-4 py-2 text-sm font-semibold text-theme-text-primary shadow-sm">
          {item}
        </span>
        {index < items.length - 1 && (
          <span class="text-theme-primary md:rotate-0 rotate-90" aria-hidden="true">→</span>
        )}
      </li>
    ))
  }
</ol>
