---
type Variant = "default" | "accent";

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;
const classes = [
  "icra-card",
  variant === "accent" && "icra-card--accent",
  className,
].filter(Boolean).join(" ");
---

<div class={classes}>
  <slot />
</div>
