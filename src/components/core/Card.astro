---
type Layout = "vertical" | "horizontal";
type Media = "portrait" | "landscape" | "none";

interface Props {
  layout?: Layout;
  media?: Media;
  interactive?: boolean;
  class?: string;
}

const {
  layout = "vertical",
  media = "none",
  interactive = false,
  class: className = "",
} = Astro.props;

const classes = [
  "icra-card",
  `icra-card--${layout}`,
  media !== "none" && `icra-card--media-${media}`,
  interactive && "icra-card--interactive",
  className,
].filter(Boolean).join(" ");
---

<article class={classes}>
  {media !== "none" && <div class="icra-card__media"><slot name="media" /></div>}
  <div class="icra-card__content">
    <slot />
  </div>
</article>
