---
type Variant = "plain" | "panel";
type SecondaryPosition = "left" | "right";
type Ratio = "balanced" | "primary" | "secondary";

interface Props {
  variant?: Variant;
  secondaryPosition?: SecondaryPosition;
  ratio?: Ratio;
  class?: string;
}

const {
  variant = "plain",
  secondaryPosition = "right",
  ratio = "balanced",
  class: className = "",
} = Astro.props;

const hasSecondary = Astro.slots.has("secondary");
const classes = [
  "icra-feature",
  `icra-feature--${variant}`,
  hasSecondary ? "icra-feature--split" : "icra-feature--single",
  `icra-feature--secondary-${secondaryPosition}`,
  `icra-feature--ratio-${ratio}`,
  className,
].filter(Boolean).join(" ");
---

<article class={classes}>
  <div class="icra-feature__primary"><slot /></div>
  {hasSecondary && <div class="icra-feature__secondary"><slot name="secondary" /></div>}
</article>
