---
type Level = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type Role = "display" | "h1" | "h2" | "h3";

interface Props {
  level?: Level;
  role?: Role;
  id?: string;
  class?: string;
}

const {
  level = "h2",
  role = "h2",
  id,
  class: className = "",
} = Astro.props;

const Element = level;
const classes = [`icra-${role}`, className].filter(Boolean).join(" ");
---

<Element id={id} class={classes}>
  <slot />
</Element>
