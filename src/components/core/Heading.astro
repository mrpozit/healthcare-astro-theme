---
type Level = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type Size = "page" | "section" | "subsection";

interface Props {
  level?: Level;
  size?: Size;
  id?: string;
  class?: string;
}

const {
  level = "h2",
  size = "section",
  id,
  class: className = "",
} = Astro.props;

const classes = ["icra-heading", `icra-heading--${size}`, className].filter(Boolean).join(" ");
const Element = level;
---

<Element id={id} class={classes}>
  <slot />
</Element>
