---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatJournalDate, journalSlug, journalTypeLabels } from "../../lib/journal";

interface Props { entry: CollectionEntry<"journal">; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const href = `/life/${journalSlug(entry.id)}/`;
const type = journalTypeLabels[entry.data.type ?? "update"];
---
<article class:list={["journal-entry", featured && "featured"]}>
  <div class="journal-copy">
    <h2><a href={href}>{entry.data.title}</a></h2>
    {entry.data.excerpt && <p class="journal-excerpt">{entry.data.excerpt}</p>}
    <p class="journal-meta"><time datetime={entry.data.date.toISOString()}>{formatJournalDate(entry.data.date)}</time><span aria-hidden="true">·</span><span>{type}</span></p>
    <a href={href} class="journal-read">Читати →</a>
  </div>
  {entry.data.cover && (
    <a href={href} class="journal-thumb" aria-label={`Читати: ${entry.data.title}`}>
      <Image src={entry.data.cover} alt="" class="journal-thumb-image" widths={[240, 360, 480]} sizes="(min-width:768px) 180px, 120px" loading={featured ? "eager" : "lazy"} />
    </a>
  )}
</article>

<style>
.journal-entry{display:grid;grid-template-columns:minmax(0,1fr) 120px;gap:1.25rem;align-items:start;padding:1.25rem 0;border-bottom:1px solid var(--icra-border)}
.journal-copy{min-width:0}.journal-copy h2{margin:0;font-size:var(--icra-text-h3-mobile);line-height:1.18;font-weight:700;color:var(--icra-text)}.journal-copy h2 a{color:inherit;text-decoration:none}.journal-copy h2 a:hover{color:var(--icra-brand-deep)}
.journal-excerpt{margin:.55rem 0 0;max-width:46rem;color:var(--icra-text-soft);font-size:1rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.journal-meta{display:flex;flex-wrap:wrap;gap:.45rem;margin:.65rem 0 0;font-size:.78rem;letter-spacing:.04em;text-transform:uppercase;color:var(--icra-text-muted)}
.journal-read{display:inline-flex;margin-top:.65rem;color:var(--icra-brand-deep);font-size:.9rem;font-weight:700;text-decoration:none}.journal-read:hover{text-decoration:underline;text-underline-offset:3px}
.journal-thumb{display:block;width:120px;aspect-ratio:4/3;overflow:hidden;border-radius:.5rem;background:var(--icra-surface-mist)}
.journal-thumb-image{display:block;width:100%;height:100%;object-fit:cover}
.journal-entry.featured{padding-top:1.5rem;padding-bottom:1.5rem}
@media(min-width:48rem){.journal-entry{grid-template-columns:minmax(0,1fr) 180px;gap:2rem;padding:1.6rem 0}.journal-thumb{width:180px}.journal-copy h2{font-size:var(--icra-text-h3)}.journal-entry.featured .journal-copy h2{font-size:var(--icra-text-h2)}}
</style>
