---
interface Props {
  src?: string;
  alt?: string;
  title: string;
  author: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { src, alt, title, author, class: className = "", loading = "lazy" } = Astro.props;
---

<div class={`aspect-[1/1.414] w-full overflow-hidden rounded-xl bg-[var(--icra-library-wood-dark)] shadow-lg ${className}`}>
  {src ? (
    <img
      src={src}
      alt={alt ?? `Обкладинка: ${title}`}
      loading={loading}
      class="h-full w-full object-contain"
      width="1000"
      height="1414"
    />
  ) : (
    <div class="flex h-full flex-col justify-between p-5 sm:p-6 text-[var(--icra-library-paper-light)]" role="img" aria-label={`Тимчасове місце для обкладинки: ${title}`}>
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[color:color-mix(in_srgb,var(--icra-library-paper-light)_65%,transparent)]">Обкладинка буде додана</span>
      <div>
        <p class="text-xl sm:text-2xl font-bold leading-tight">{title}</p>
        <p class="mt-3 text-sm text-[color:color-mix(in_srgb,var(--icra-library-paper-light)_70%,transparent)]">{author}</p>
      </div>
      <span class="text-xs text-[color:color-mix(in_srgb,var(--icra-library-paper-light)_55%,transparent)]">ICRA · Бібліотека</span>
    </div>
  )}
</div>
