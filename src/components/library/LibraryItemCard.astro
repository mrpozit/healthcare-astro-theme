---
import LibraryCover from "./LibraryCover.astro";
import { libraryTypeLabels, libraryStatusLabels, type LibraryItem } from "../../data/library";

interface Props {
  item: LibraryItem;
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
---

<article class={`group ${compact ? "" : "border-b border-theme-border pb-7"}`} data-library-item data-type={item.type} data-search={`${item.title} ${item.author} ${item.description} ${item.topics.join(" ")}`.toLowerCase()}>
  <a href={`/library/${item.slug}`} class={`grid ${compact ? "grid-cols-[72px_1fr] gap-4" : "grid-cols-[110px_1fr] sm:grid-cols-[140px_1fr] gap-5 sm:gap-7"} items-start`}>
    <LibraryCover src={item.cover} alt={item.coverAlt} title={item.title} author={item.author} />
    <div class="min-w-0 pt-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold uppercase tracking-wider text-theme-primary">
        <span>{libraryTypeLabels[item.type]}</span>
        {item.status && <><span aria-hidden="true">·</span><span class="text-theme-text-muted">{libraryStatusLabels[item.status]}</span></>}
      </div>
      <h3 class={`${compact ? "mt-1 text-base" : "mt-2 text-xl sm:text-2xl"} font-bold leading-tight text-theme-text-primary group-hover:text-theme-primary transition-colors`}>
        {item.title}
      </h3>
      <p class="mt-1 text-sm text-theme-text-muted">{item.author}</p>
      {!compact && <p class="mt-3 text-sm sm:text-base leading-relaxed text-theme-text-secondary">{item.description}</p>}
    </div>
  </a>
</article>
