---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/core/Heading.astro";
import ActionLink from "../components/core/ActionLink.astro";
---

<Layout title="Сторінку не знайдено | ICRA" description="Запитану сторінку ICRA не знайдено.">
  <section class="icra-section icra-section--spacious icra-surface icra-surface--mist error-page">
    <div class="icra-container error-inner">
      <p class="error-code" aria-hidden="true">404</p>
      <Heading level="h1" role="display">Цієї сторінки тут немає</Heading>
      <p class="icra-lead">Можливо, адресу було змінено або сторінка більше не існує.</p>
      <div class="error-actions"><ActionLink href="/">На головну</ActionLink><ActionLink href="/library">До Бібліотеки</ActionLink></div>
    </div>
  </section>
</Layout>

<style>
.error-page{min-height:65vh;display:grid;align-items:center}.error-inner{max-width:var(--icra-container-content);text-align:center}.error-code{margin:0 0 1rem;color:color-mix(in srgb,var(--icra-brand) 24%,transparent);font-size:clamp(5rem,18vw,10rem);font-weight:700;line-height:.8}.error-inner .icra-lead{max-width:38rem;margin:1.5rem auto 0}.error-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;margin-top:2rem}
</style>
