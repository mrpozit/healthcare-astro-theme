---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/core/Heading.astro";
import LibraryCover from "../components/library/LibraryCover.astro";
import { libraryItems, libraryTypeLabels } from "../data/library";

const items = [...libraryItems].sort((a,b)=>(a.editorialOrder ?? 99)-(b.editorialOrder ?? 99));
const categories = [["all","Усе"], ...Object.entries(libraryTypeLabels)];
---

<Layout title="Бібліотека ICRA | Матеріали, тексти та книги" description="Бібліотека ICRA. Тексти, книги, практичні матеріали, дослідження та інші результати нашої роботи.">
  <main class="library-page">
    <section class="library-hero">
      <div class="library-container hero-grid">
        <div>
          <p class="eyebrow">ICRA / Бібліотека</p>
          <Heading level="h1" role="display">Місце, де речі залишаються</Heading>
        </div>
        <div class="hero-copy">
          <p>Тексти, книги, практичні матеріали, дослідження та історії, які народжуються з роботи ICRA.</p>
          <p>Щось можна прочитати тут. Щось завантажити. Деякі матеріали ведуть до окремої книги або зовнішнього ресурсу.</p>
          <p class="strong">Не стрічка новин. Сховище того, до чого можна повернутися.</p>
        </div>
      </div>
    </section>

    <section class="library-tools" aria-label="Навігація бібліотеки">
      <div class="library-container tools-row">
        <nav class="filters" aria-label="Типи матеріалів" data-library-filters>
          {categories.map(([value,label],i)=><button type="button" data-filter={value} aria-pressed={i===0?"true":"false"}>{label}</button>)}
        </nav>
        <label class="search"><span class="sr-only">Пошук у бібліотеці</span><input id="library-search" type="search" placeholder="Знайти матеріал" /></label>
      </div>
    </section>

    <section class="library-shelf" aria-labelledby="materials-title">
      <div class="library-container">
        <div class="shelf-head">
          <div><p class="eyebrow">Колекція</p><Heading level="h2" role="h2" id="materials-title">Матеріали</Heading></div>
          <p class="shelf-note">У кожного матеріалу своя обкладинка і свій спосіб доступу.</p>
        </div>

        <div class="book-grid" data-library-grid>
          {items.map((item)=>(
            <article class="book" data-library-item data-type={item.type} data-search={`${item.title} ${item.author} ${item.description} ${item.topics.join(" ")}`.toLowerCase()}>
              <a href={`/library/${item.slug}`} class="cover-link">
                <LibraryCover src={item.cover} alt={item.coverAlt} title={item.title} author={item.author} />
              </a>
              <div class="book-meta">
                <p class="type">{libraryTypeLabels[item.type]}</p>
                <Heading level="h3" role="h3"><a href={`/library/${item.slug}`}>{item.title}</a></Heading>
                <p class="author">{item.author}</p>
                <p class="description">{item.description}</p>
                <a class="open-link" href={`/library/${item.slug}`}>Відкрити матеріал →</a>
              </div>
            </article>
          ))}
        </div>
        <p id="library-empty" class="empty" hidden>За цим запитом матеріалів поки немає.</p>
      </div>
    </section>

    <section class="library-principle">
      <div class="library-container principle-grid">
        <p class="eyebrow">Принцип</p>
        <Heading level="h2" role="h2" class="principle-title">Бібліотека не просить читати все.</Heading>
        <p>Візьміть те, що виявиться потрібним. Решта може просто залишитися на полиці до свого часу.</p>
      </div>
    </section>
  </main>

  <script>
    const initLibrary = () => {
      const search = document.querySelector<HTMLInputElement>("#library-search");
      const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
      const items = Array.from(document.querySelectorAll<HTMLElement>("[data-library-item]"));
      const empty = document.querySelector<HTMLElement>("#library-empty");
      let activeType = "all";
      const apply = () => {
        const q = search?.value.trim().toLowerCase() ?? "";
        let visible=0;
        items.forEach((item)=>{
          const show=(activeType==="all" || item.dataset.type===activeType) && (!q || (item.dataset.search ?? "").includes(q));
          item.hidden=!show; if(show) visible++;
        });
        if(empty) empty.hidden=visible!==0;
      };
      filters.forEach((button)=>button.addEventListener("click",()=>{
        activeType=button.dataset.filter ?? "all";
        filters.forEach((b)=>b.setAttribute("aria-pressed",String(b===button)));
        apply();
      }));
      search?.addEventListener("input",apply);
    };
    document.addEventListener("astro:page-load",initLibrary);
    initLibrary();
  </script>
</Layout>

<style>
.library-page{background:var(--icra-library-paper-light);color:var(--icra-library-ink)}.library-container{width:min(calc(100% - 2 * var(--icra-gutter-mobile)),var(--icra-container-wide));margin-inline:auto}.library-hero{padding:var(--icra-section-spacious) 0;background:var(--icra-library-paper)}.hero-grid{display:grid;gap:var(--icra-space-5)}.eyebrow{margin:0 0 var(--icra-space-2);font-size:var(--icra-text-eyebrow);font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--icra-library-wood)}.hero-copy{display:grid;gap:1rem;align-self:end;max-width:42rem;font-size:var(--icra-text-body-lg-mobile);line-height:var(--icra-leading-body);color:var(--icra-library-text)}.hero-copy p{margin:0}.hero-copy .strong{color:var(--icra-library-ink);font-weight:700}.library-tools{position:sticky;top:0;z-index:10;border-block:1px solid var(--icra-library-border);background:color-mix(in srgb,var(--icra-library-paper-light) 94%,transparent);backdrop-filter:blur(12px)}.tools-row{display:flex;flex-direction:column;gap:1rem;padding-block:1rem}.filters{display:flex;gap:.5rem;overflow-x:auto;scrollbar-width:none}.filters::-webkit-scrollbar{display:none}.filters button{flex:none;border:1px solid var(--icra-library-border);border-radius:999px;background:var(--icra-library-paper-light);padding:.65rem 1rem;font:inherit;font-size:var(--icra-text-small);font-weight:700;color:var(--icra-library-text);cursor:pointer}.filters button[aria-pressed="true"]{border-color:var(--icra-library-wood);background:var(--icra-library-wood);color:var(--icra-library-paper-light)}.search input{width:100%;border:1px solid var(--icra-library-border);border-radius:999px;background:var(--icra-library-paper-light);padding:.7rem 1rem;font:inherit;color:var(--icra-library-ink)}.library-shelf{padding:var(--icra-section-spacious) 0}.shelf-head{display:grid;gap:1rem;margin-bottom:var(--icra-space-5)}.shelf-note{margin:0;max-width:30rem;color:var(--icra-library-text);line-height:1.6}.book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--icra-space-5) var(--icra-space-3);align-items:start}.book{min-width:0}.cover-link{display:block;max-width:18rem;text-decoration:none}.book-meta{padding-top:1rem}.type,.author,.description{margin:0}.type{font-size:var(--icra-text-small);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--icra-library-wood)}.book-meta h3{margin-top:.45rem}.book-meta h3 a{color:inherit;text-decoration:none}.author{margin-top:.4rem;color:var(--icra-library-text);font-size:var(--icra-text-small)}.description{display:none;margin-top:.8rem;line-height:1.6;color:var(--icra-library-text)}.open-link{display:inline-flex;margin-top:.8rem;color:var(--icra-library-wood);font-weight:700;text-decoration:none}.empty{padding:2rem;border:1px solid var(--icra-library-border);border-radius:var(--icra-radius-card);color:var(--icra-library-text)}.library-principle{padding:var(--icra-section-spacious) 0;background:var(--icra-library-wood-deep);color:var(--icra-library-paper-light)}.principle-grid{display:grid;gap:var(--icra-space-3)}.principle-title{color:var(--icra-library-paper-light)}.principle-grid .eyebrow{color:var(--icra-library-accent)}.principle-grid p:last-child{margin:0;max-width:42rem;font-size:var(--icra-text-body-lg-mobile);line-height:var(--icra-leading-body);color:color-mix(in srgb,var(--icra-library-paper-light) 78%,transparent)}
@media(min-width:48rem){.library-container{width:min(calc(100% - 2 * var(--icra-gutter-tablet)),var(--icra-container-wide))}.hero-copy{font-size:var(--icra-text-body-lg)}.tools-row{flex-direction:row;align-items:center;justify-content:space-between}.search{width:18rem;flex:none}.shelf-head{grid-template-columns:1fr auto;align-items:end}.book-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--icra-space-6) var(--icra-space-4)}.description{display:block}.principle-grid p:last-child{font-size:var(--icra-text-body-lg)}}
@media(min-width:64rem){.library-container{width:min(calc(100% - 2 * var(--icra-gutter-desktop)),var(--icra-container-wide))}.hero-grid{grid-template-columns:1.1fr .9fr}.book-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.principle-grid{grid-template-columns:.35fr 1fr 1fr;align-items:start}}
</style>