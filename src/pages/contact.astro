---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import contactImage from "../assets/contact-image.jpg";

const socialLinks = [
  { label: "Instagram", href: "https://www.instagram.com/" },
  { label: "TikTok", href: "https://www.tiktok.com/" },
  { label: "YouTube", href: "https://www.youtube.com/" },
  { label: "Substack", href: "https://substack.com/" },
  { label: "LinkedIn", href: "https://www.linkedin.com/" },
];
---

<Layout
  title="Контакти | ICRA"
  description="Зв'яжіться з Міжнародним центром відновлення і адаптації через соціальні мережі або форму зворотного зв'язку."
>
  <PageHero
    title="Контакти"
    description="Оберіть зручний спосіб зв'язку або напишіть нам через форму."
    image={contactImage}
  />

  <section
    class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
    id="contact"
  >
    <div class="container">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 items-start">
        <div class="pt-2">
          <p class="text-sm font-semibold uppercase tracking-wider text-theme-primary mb-3">
            Ми в соцмережах
          </p>
          <h2 class="text-3xl font-bold text-theme-text-primary mb-4">
            Залишаймося на зв'язку
          </h2>
          <p class="text-lg text-theme-text-secondary mb-8 max-w-xl">
            Новини, матеріали, відео та анонси наших проєктів можна знайти на наших сторінках.
          </p>

          <div class="grid gap-3 sm:grid-cols-2 max-w-xl">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between rounded-xl border border-theme-border bg-theme-surface px-5 py-4 font-semibold text-theme-text-primary transition-all duration-200 hover:border-theme-primary hover:text-theme-primary hover:shadow-md"
                >
                  <span>{social.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))
            }
          </div>
        </div>

        <div
          class="bg-white rounded-2xl shadow-xl p-8 md:p-10 border border-gray-100 hover:shadow-2xl transition-shadow duration-300"
          id="form"
        >
          <h2 class="mb-2 text-2xl font-bold text-theme-text-primary">
            Напишіть нам
          </h2>
          <p class="mb-6 text-theme-text-secondary">
            Оберіть тему звернення — так ми одразу зрозуміємо, кому передати ваше повідомлення.
          </p>

          <form
            action="https://formsubmit.co/icra.centre@gmail.com"
            method="POST"
          >
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />

            <div class="mb-5">
              <label
                for="name"
                class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
              >Ім'я</label>
              <input
                type="text"
                id="name"
                autocomplete="name"
                placeholder="Ваше ім'я"
                class="w-full rounded-lg bg-white ring-1 ring-gray-300 focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 px-4 text-theme-text-primary transition-all duration-200"
                name="Ім'я"
                required
              />
            </div>

            <div class="mb-5">
              <label
                for="email"
                class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
              >Email</label>
              <input
                type="email"
                id="email"
                autocomplete="email"
                placeholder="Ваш email"
                class="w-full rounded-lg bg-white ring-1 ring-gray-300 focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 px-4 text-theme-text-primary transition-all duration-200"
                name="email"
                required
              />
            </div>

            <div class="mb-5">
              <label
                for="subject"
                class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
              >Тема звернення</label>
              <select
                id="subject"
                name="_subject"
                class="w-full rounded-lg bg-white ring-1 ring-gray-300 focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 px-4 text-theme-text-primary transition-all duration-200"
                required
              >
                <option value="" disabled selected>Оберіть тему</option>
                <option value="Консультація">Консультація</option>
                <option value="Співпраця / партнерство">Співпраця / партнерство</option>
                <option value="Благодійна допомога">Благодійна допомога</option>
              </select>
            </div>

            <div class="mb-6">
              <label
                for="message"
                class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
              >Повідомлення</label>
              <textarea
                id="message"
                name="Повідомлення"
                cols="30"
                rows="6"
                placeholder="Напишіть ваше повідомлення..."
                required
                class="w-full rounded-lg bg-white ring-1 ring-gray-300 focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 px-4 text-theme-text-primary transition-all duration-200"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-theme-primary hover:bg-theme-primary-dark text-white px-6 py-3 text-lg font-semibold rounded-lg transition-all duration-300 hover:shadow-lg"
            >
              Надіслати повідомлення
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
