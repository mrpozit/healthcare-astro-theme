---
import Layout from "../../layouts/Layout.astro";
import LibraryCover from "../../components/library/LibraryCover.astro";
import { getCollection, render } from "astro:content";
import { libraryTypeLabels, libraryStatusLabels } from "../../data/library";

export async function getStaticPaths() {
  const entries = await getCollection("library", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\\/g, "/").replace(/\/index$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const item = { slug: entry.id.replace(/\\/g, "/").replace(/\/index$/, ""), ...entry.data };
const { Content } = await render(entry);
---


<Layout title={`${item.title} | Бібліотека ICRA`} description={item.description}>
  <article class="section bg-theme-surface-muted">
    <div class="container">
      <a href="/careers" class="inline-flex mb-8 font-semibold text-theme-primary hover:underline underline-offset-4">← Бібліотека</a>

      <div class="grid gap-10 lg:grid-cols-[minmax(260px,0.38fr)_minmax(0,0.62fr)] lg:gap-16 items-start">
        <div class="max-w-[380px] w-full mx-auto lg:mx-0">
          <LibraryCover src={item.cover?.src} title={item.title} author={item.author} loading="eager" />
        </div>

        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 text-sm font-semibold uppercase tracking-wider text-theme-primary mb-4">
            <span>{libraryTypeLabels[item.type]}</span><span aria-hidden="true">·</span><span>{item.author}</span>
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold leading-tight text-theme-text-primary">{item.title}</h1>
          <p class="mt-5 text-lg lg:text-xl leading-relaxed text-theme-text-secondary">{item.description}</p>
          {item.status && <p class="mt-4 text-sm text-theme-text-muted">Статус: {libraryStatusLabels[item.status]}</p>}

          {item.externalUrl && (
            <div class="mt-8"><a href={item.externalUrl} class="button button-primary" target="_blank" rel="noopener noreferrer">{item.externalLabel ?? "Відкрити ресурс"}</a></div>
          )}
          {item.pdf && (
            <div class="mt-8"><a href={item.pdf} class="button button-primary">Завантажити PDF</a></div>
          )}
        </div>
      </div>

      <section class="mt-14 lg:mt-20 max-w-[760px] mx-auto library-reading" aria-label="Текст матеріалу">
        <Content />
      </section>
    </div>
  </article>
</Layout>
