---
import Layout from "../../layouts/Layout.astro";
import LibraryCover from "../../components/library/LibraryCover.astro";
import { getCollection, render } from "astro:content";
import { libraryTypeLabels, libraryStatusLabels } from "../../lib/library";

export async function getStaticPaths() {
  const entries = await getCollection("library", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\\/g, "/").replace(/\/index$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const item = { slug: entry.id.replace(/\\/g, "/").replace(/\/index$/, ""), ...entry.data };
const { Content } = await render(entry);
---


<Layout title={`${item.title} | Бібліотека ICRA`} description={item.description}>
  <article class="section bg-theme-surface-muted">
    <div class="container">
      <a href="/library" class="inline-flex mb-8 font-semibold text-theme-primary hover:underline underline-offset-4">← Бібліотека</a>

      <div class="grid gap-10 lg:grid-cols-[minmax(260px,0.38fr)_minmax(0,0.62fr)] lg:gap-16 items-start">
        <div class="max-w-[380px] w-full mx-auto lg:mx-0">
          <LibraryCover src={item.cover?.src} title={item.title} author={item.author} loading="eager" />
        </div>

        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 text-sm font-semibold uppercase tracking-wider text-theme-primary mb-4">
            <span>{libraryTypeLabels[item.type]}</span><span aria-hidden="true">·</span><span>{item.author}</span>
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold leading-tight text-theme-text-primary">{item.title}</h1>
          <p class="mt-5 text-lg lg:text-xl leading-relaxed text-theme-text-secondary">{item.description}</p>
          {item.status && <p class="mt-4 text-sm text-theme-text-muted">Статус: {libraryStatusLabels[item.status]}</p>}

          {item.externalUrl && (
            <div class="mt-8"><a href={item.externalUrl} class="button button-primary" target="_blank" rel="noopener noreferrer">{item.externalLabel ?? "Відкрити ресурс"}</a></div>
          )}
          {item.pdf && (
            <div class="mt-8"><a href={item.pdf} class="button button-primary">Завантажити PDF</a></div>
          )}
        </div>
      </div>

      <section class="mt-14 lg:mt-20 max-w-[760px] mx-auto library-reading" aria-label="Текст матеріалу">
        <Content />
      </section>
    </div>
  </article>
</Layout>


<style>
  .library-reading {
    color: var(--icra-text);
    font-size: 1.0625rem;
    line-height: 1.78;
  }

  .library-reading :global(p) {
    margin: 0 0 1.35em;
  }

  .library-reading :global(h2) {
    margin: 2.4em 0 0.7em;
    font-size: var(--icra-text-h2-mobile);
    line-height: 1.16;
    font-weight: 700;
    color: var(--icra-text);
  }

  .library-reading :global(h3) {
    margin: 2em 0 0.65em;
    font-size: var(--icra-text-h3-mobile);
    line-height: 1.25;
    font-weight: 700;
    color: var(--icra-text);
  }

  .library-reading :global(h2 + p),
  .library-reading :global(h3 + p) {
    margin-top: 0;
  }

  .library-reading :global(blockquote) {
    margin: 2em 0;
    padding: 0.2em 0 0.2em 1.25rem;
    border-left: 3px solid var(--icra-library-accent);
    color: var(--icra-text-soft);
    font-style: italic;
  }

  .library-reading :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .library-reading :global(ul),
  .library-reading :global(ol) {
    margin: 1.25em 0 1.5em;
    padding-left: 1.5em;
  }

  .library-reading :global(li) {
    margin: 0.45em 0;
    padding-left: 0.2em;
  }

  .library-reading :global(hr) {
    margin: 3rem auto;
    width: min(10rem, 40%);
    border: 0;
    border-top: 1px solid var(--icra-library-border);
  }

  .library-reading :global(a) {
    color: var(--icra-brand-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .library-reading :global(strong) {
    font-weight: 700;
  }

  .library-reading :global(img) {
    display: block;
    width: auto;
    max-width: min(100%, 720px);
    max-height: 78vh;
    height: auto;
    margin: 2.5rem auto;
    border-radius: var(--icra-radius-card);
  }

  @media (min-width: 48rem) {
    .library-reading {
      font-size: 1.125rem;
      line-height: 1.82;
    }

    .library-reading :global(h2) {
      font-size: var(--icra-text-h2);
    }

    .library-reading :global(h3) {
      font-size: var(--icra-text-h3);
    }
  }
</style>
