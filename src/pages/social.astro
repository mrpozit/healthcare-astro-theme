---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Section from "../components/core/Section.astro";
import Heading from "../components/core/Heading.astro";
import Text from "../components/core/Text.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import Statement from "../components/core/Statement.astro";
import Callout from "../components/core/Callout.astro";
import ActionLink from "../components/core/ActionLink.astro";

const modules = import.meta.glob("../assets/pages/social/**/*.{jpg,jpeg,png,webp}", { eager: true });
const projectImages = (project: string) => Object.entries(modules)
  .filter(([path]) => path.includes(`/social/${project}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => (mod as { default: ImageMetadata }).default);
const orientation = (img: ImageMetadata) => img.height > img.width ? "portrait" : "landscape";

const kyrylivska = projectImages("kyrylivska");
const probation = projectImages("probation");
const valkyries = projectImages("valkyries");
const osoblyvi = projectImages("osoblyvi-zhinky");
const recovery = projectImages("recovery");
const teenagers = projectImages("teenagers");
const mudryni = projectImages("mudryni");
const heroImage = kyrylivska[0] ?? probation[0] ?? valkyries[0];
---

<Layout title="Суспільна діяльність | ICRA" description="Суспільна діяльність ICRA: жива практика, партнерські проєкти та робота з різними спільнотами.">
  <main class="overflow-hidden">
    <Section surface="sky" spacing="spacious" width="wide" labelledby="social-title" class="social-hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <Eyebrow>Суспільна діяльність</Eyebrow>
          <Heading level="h1" role="display" id="social-title">Частину важливої роботи ми просто робимо</Heading>
          <div class="copy-stack">
            <Text role="lead">Не вся робота ICRA починається з питання, хто за неї заплатить.</Text>
            <Text role="body-lg">Ми співпрацюємо з українськими організаціями, працюємо з ветеранами, звільненими з полону, фахівцями допомагаючих професій, жінками ВПО, підлітками та іншими групами.</Text>
            <Text>Іноді це партнерський проєкт. Іноді волонтерська робота. Іноді кілька зустрічей. Іноді робота, яка триває місяцями.</Text>
          </div>
          <ActionLink href="#projects">Подивитися проєкти</ActionLink>
        </div>
        {heroImage && <div class="hero-photo"><span class="tape">НЕ ДЛЯ ЗВІТУ</span><Image src={heroImage} alt="Суспільна практика ICRA" widths={[640,960]} sizes="(min-width:1024px) 40vw, 100vw" loading="eager" /></div>}
      </div>
      <p class="hero-note">Це не окреме «соціальне обличчя» ICRA. Це просто частина того, що ми робимо.</p>
    </Section>

    <Section id="projects" surface="white" spacing="spacious" width="wide" labelledby="contexts-title">
      <div class="section-intro">
        <div><Eyebrow>Жива практика</Eyebrow><Heading level="h2" role="h2" id="contexts-title">Різні люди. Різні контексти.</Heading></div>
        <Text role="lead">Метод або формат, який працює з однією групою, не можна механічно переносити на всіх. Саме тому суспільна робота ICRA відбувається в дуже різних середовищах.</Text>
      </div>

      <article class="project project-k103">
        <div class="project-head"><span class="num">01</span><div><Eyebrow>Постійна практика</Eyebrow><Heading level="h2" role="h2">Кирилівська, 103</Heading><Text role="lead">Робота з ветеранами та людьми, звільненими з полону</Text></div></div>
        <div class="project-copy"><Text>У психіатричному відділенні ми регулярно працюємо з групами ветеранів і людей, які пережили полон.</Text><Text>Ця робота стала одним із місць, де особливо виразно проявилася взаємодія тексту, арт-терапевтичної практики та подальшої роботи з психологом і психіатром.</Text><Statement>Текст допомагає впізнати себе. Практика дозволяє торкнутися теми без примусу до сповіді. А далі стає можливою глибша робота.</Statement></div>
        <div class="gallery">{kyrylivska.slice(1).map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Практика на Кирилівській, 103. Фото ${i + 1}`} widths={[480,720]} sizes="(min-width:768px) 33vw, 100vw" loading="lazy" /></figure>)}</div>
      </article>

      <div class="two-projects">
        <article class="project-card sand"><span class="num small">02</span><Heading level="h3" role="h3">Фахівці пробації</Heading><Text>У співпраці з Українською пробацією Міністерства юстиції України Патриція проводить безкоштовні заняття для фахівців. Це можуть бути навчальні формати або сесії психологічного розвантаження для людей, чия робота сама по собі пов'язана з постійним емоційним навантаженням.</Text><div class="gallery compact">{probation.map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Робота з фахівцями пробації. Фото ${i + 1}`} widths={[420,640]} sizes="(min-width:768px) 24vw, 100vw" loading="lazy" /></figure>)}</div></article>
        <article class="project-card wine"><span class="num small">03</span><Heading level="h3" role="h3">«Українські Валькірії»</Heading><Text>У межах проєкту Патриція проводить лекції, вебінари, практикуми та майстер-класи для учасниць організації, жінок ВПО та фахівців допомагаючих професій.</Text><Text>Теми і формат залежать від конкретної групи: від роботи зі стресом та емоційною саморегуляцією до арт-терапевтичних практик і психологічного відновлення.</Text><div class="gallery compact">{valkyries.map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Українські Валькірії. Фото ${i + 1}`} widths={[420,640]} sizes="(min-width:768px) 24vw, 100vw" loading="lazy" /></figure>)}</div></article>
      </div>

      <div class="poster"><Eyebrow>Допомога тим, хто допомагає</Eyebrow><Heading level="h2" role="display-xl">«Ресурс спеціаліста теж не безмежний»</Heading></div>

      <article class="project recovery-project">
        <div class="project-head"><span class="num">04</span><div><Heading level="h2" role="h2">Recovery Ukraine</Heading><Text role="body-lg">У межах проєктів Recovery Ukraine Патриція проводила заходи з психологічного розвантаження та відновлення для фахівців допомагаючих професій, які працюють із військовослужбовцями та ветеранами.</Text><Text>У допомагаючих професіях легко зосередитися лише на тому, кому допомагає спеціаліст. Але ресурс самого спеціаліста теж не безмежний.</Text><ActionLink href="https://recoveryua.org/" external>Recovery Ukraine</ActionLink></div></div>
        <div class="gallery">{recovery.map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Recovery Ukraine. Фото ${i + 1}`} widths={[480,720]} sizes="(min-width:768px) 30vw, 100vw" loading="lazy" /></figure>)}</div>
      </article>

      <article class="project special-project">
        <div class="project-head"><span class="num">05</span><div><Eyebrow>Ще одна історія співпраці</Eyebrow><Heading level="h2" role="h2">«Особливі Жінки України»</Heading><Text role="lead">Цей проєкт додаємо до живої мапи суспільної практики ICRA.</Text></div></div>
        <div class="gallery">{osoblyvi.map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Особливі Жінки України. Фото ${i + 1}`} widths={[480,720]} sizes="(min-width:768px) 30vw, 100vw" loading="lazy" /></figure>)}</div>
      </article>

      <article class="project teens-project">
        <div class="project-head"><span class="num">06</span><div><Heading level="h2" role="h2">Підлітки</Heading><Text role="body-lg">Окремий напрям практики Патриції - робота з підлітками у школі.</Text><Text>Зустрічі присвячені стресу, емоціям, способам помічати власний стан і простим інструментам саморегуляції.</Text><Text>Тут особливо важливо говорити з людиною зрозумілою мовою, не перетворюючи психологію на лекцію про те, як вона «повинна правильно почуватися».</Text></div></div>
        {teenagers.length > 0 && <div class="gallery">{teenagers.map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Робота з підлітками. Фото ${i + 1}`} widths={[480,720]} sizes="(min-width:768px) 30vw, 100vw" loading="lazy" /></figure>)}</div>}
      </article>

      <article class="project mudryni-project">
        <div class="project-head"><span class="num">07</span><div><Eyebrow>Проєкт</Eyebrow><Heading level="h2" role="h2">«Мудрині»</Heading><Text role="lead">Ще одна історія суспільної практики ICRA.</Text></div></div>
        {mudryni.length > 0 && <div class="gallery">{mudryni.map((img, i) => <figure class:list={["photo", orientation(img)]}><Image src={img} alt={`Мудрині. Фото ${i + 1}`} widths={[480,720]} sizes="(min-width:768px) 30vw, 100vw" loading="lazy" /></figure>)}</div>}
      </article>
    </Section>

    <Section surface="aqua" spacing="spacious" width="wide" labelledby="helpers-title">
      <div class="helper-grid"><div><Eyebrow>Допомога тим, хто допомагає</Eyebrow><Heading level="h2" role="h2" id="helpers-title">Є робота, яку не видно зовні</Heading></div><div class="copy-stack"><Text role="lead">Психологи. Соціальні працівники. Фахівці, які працюють із ветеранами. Працівники громадських організацій. Люди, які щодня мають справу з чужою кризою, болем або складними життєвими обставинами.</Text><Text role="body-lg">Допомагаюча професія не робить людину невразливою. Вона лише створює ситуацію, в якій власне виснаження дуже легко відкласти на потім.</Text></div><Statement>Той, хто підтримує інших, теж потребує місця, де не потрібно нікого підтримувати.</Statement></div>
    </Section>

    <Section surface="sand" spacing="spacious" width="wide" labelledby="small-title"><div class="small-grid"><div><span class="num small">08</span><Heading level="h2" role="h2" id="small-title">Невеликі спільноти для нас теж мають значення</Heading></div><div><Text role="body-lg">Не кожна суспільна ініціатива повинна бути великим проєктом.</Text><Text>Іноді це разовий безкоштовний майстер-клас із нейрографіки. Іноді подарункові сертифікати для учасників спільноти. Іноді невелика зустріч, яка просто може бути корисною людям саме зараз.</Text></div><Callout>Ми не вимірюємо сенс роботи лише масштабом аудиторії.</Callout></div></Section>

    <Section surface="wine" spacing="spacious" width="wide" labelledby="principle-title"><div class="final-grid"><div><Eyebrow>Принцип</Eyebrow><Heading level="h2" role="h2" id="principle-title">Суспільна робота для нас не окреме «соціальне обличчя»</Heading></div><div class="copy-stack"><Text role="lead">Іноді це партнерський проєкт. Іноді волонтерська робота. Іноді кілька зустрічей. Іноді робота, яка триває місяцями.</Text><Text role="body-lg">Це просто частина того, що ми робимо.</Text><ActionLink href="/contact">Зв'язатися з ICRA</ActionLink></div></div></Section>
  </main>
</Layout>

<style>
  .hero-grid,.section-intro,.helper-grid,.final-grid,.small-grid{display:grid;gap:clamp(2rem,5vw,5rem)}
  .hero-grid{align-items:end}.hero-copy{max-width:52rem}.copy-stack{display:grid;gap:1rem;margin:2rem 0}.hero-photo{position:relative;max-width:34rem;justify-self:end}.hero-photo :global(img){display:block;width:100%;aspect-ratio:3/5;object-fit:cover;border-radius:0 3rem 0 3rem;box-shadow:0 2rem 5rem rgb(18 42 48/.18);transform:rotate(1deg)}
  .tape{position:absolute;z-index:2;top:-1rem;left:-1rem;padding:.6rem .8rem;background:var(--icra-brand-dark);color:white;font-size:.72rem;font-weight:800;letter-spacing:.12em;transform:rotate(-5deg)}.hero-note{margin-top:clamp(3rem,7vw,6rem);max-width:42rem;font-size:1.35rem;line-height:1.5;font-weight:700}
  .section-intro{margin-bottom:clamp(4rem,9vw,8rem);align-items:end}.project{display:grid;gap:2.5rem;margin-bottom:clamp(5rem,10vw,10rem)}.project-head{display:grid;gap:2rem}.project-head>div{display:grid;gap:1rem}.project-copy{display:grid;gap:1rem;max-width:48rem;margin-left:auto}.num{font-size:clamp(4rem,9vw,7rem);font-weight:800;line-height:.8;opacity:.13}.num.small{font-size:2.4rem}
  .gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:start}.photo{margin:0;min-width:0}.photo :global(img){display:block;width:100%;height:auto;border-radius:var(--icra-radius-media)}.photo.landscape{grid-column:span 2}.photo.portrait{grid-column:span 1}.gallery.compact{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery.compact .photo.landscape{grid-column:span 2}
  .two-projects{display:grid;gap:2rem;margin-bottom:clamp(4rem,9vw,8rem);align-items:start}.project-card{display:grid;gap:1.25rem;padding:clamp(1.5rem,4vw,3rem);border-radius:2rem}.project-card.sand{background:var(--icra-surface-sand)}.project-card.wine{margin-top:0;background:var(--icra-surface-wine);color:#fff;--surface-heading:#fff;--surface-text:#f9fafb;--surface-accent:#fff}
  .poster{max-width:70rem;margin:clamp(5rem,11vw,10rem) auto;text-align:center}.poster :global(.icra-eyebrow){margin-bottom:1.5rem}
  .special-project{padding:clamp(2rem,5vw,4rem);background:linear-gradient(135deg,var(--icra-surface-ice),#fff);border-radius:2rem}.teens-project{padding:clamp(2rem,5vw,4rem);border:1px solid var(--icra-border);border-radius:2rem}.mudryni-project{padding:clamp(2rem,5vw,4rem);background:var(--icra-surface-sand);border-radius:2rem}.helper-grid{align-items:start}.small-grid{align-items:center}.final-grid{align-items:end}
  @media(min-width:48rem){.gallery{grid-template-columns:repeat(4,minmax(0,1fr))}.photo.landscape{grid-column:span 2}.photo.portrait{grid-column:span 1}.gallery.compact{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery.compact .photo.landscape{grid-column:span 2}.two-projects{grid-template-columns:1.05fr .95fr}.project-card.wine{margin-top:7rem}.small-grid{grid-template-columns:1fr 1fr .8fr}}
  @media(min-width:64rem){.hero-grid{grid-template-columns:1.12fr .88fr}.section-intro{grid-template-columns:.82fr 1.18fr}.project-head{grid-template-columns:.2fr 1fr;max-width:58rem}.project-k103{grid-template-columns:.8fr 1.2fr}.project-k103 .project-head{grid-column:1/-1}.project-k103 .gallery{grid-column:1/-1}.recovery-project,.special-project,.teens-project,.mudryni-project{grid-template-columns:.75fr 1.25fr}.helper-grid{grid-template-columns:.8fr 1.1fr .8fr}.final-grid{grid-template-columns:1.1fr .9fr}}
  @media(max-width:47.99rem){.hero-photo{justify-self:stretch}.gallery,.gallery.compact{grid-template-columns:repeat(2,minmax(0,1fr))}.photo.landscape,.gallery.compact .photo.landscape{grid-column:1/-1}.photo.portrait{grid-column:span 1}.project-card.wine{margin-top:0}}
</style>
