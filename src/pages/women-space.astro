---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/CallToActionSection.astro';
---

<Layout 
  title="Простір жіночих трансформацій" 
  description="Програми та зустрічі для жінок: арт-терапія, ресурси, психологічна підтримка та відновлення."
>
  <main class="container mx-auto px-4 py-12">
    <!-- Заголовок страницы -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-4xl font-bold mb-4">Простір жіночих трансформацій</h1>
      <p class="text-lg text-theme-text-secondary">
        Безпечний простір для відновлення внутрішнього ресурсу, гармонізації та розвитку.
      </p>
    </div>

    <!-- Здесь позже разместим описание программ и арт-терапии -->
  </main>
  
  <Cta />
</Layout>