---
import Layout from "../layouts/Layout.astro";
import CallToActionSection from "../components/CallToActionSection.astro";

const directions = [
  {
    title: "Арт-терапія",
    description: "Творчі практики, які допомагають краще почути себе та побачити власні переживання з іншого боку.",
  },
  {
    title: "Відновлення ресурсу",
    description: "Зустрічі та практики для відновлення внутрішньої опори, уваги до себе та власних потреб.",
  },
  {
    title: "Безпечне спілкування",
    description: "Простір без оцінювання та тиску, де можна говорити, досліджувати себе й бути почутою.",
  },
];
---

<Layout
  title="Жіночий простір | МЦ відновлення та адаптації"
  description="Безпечний простір для жінок: арт-терапія, відновлення ресурсу, психологічна підтримка та зустрічі."
>
  <main>
    <section class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-wider text-theme-primary mb-3">
            Жіночий простір
          </p>
          <h1 class="text-4xl lg:text-5xl font-bold text-theme-text-primary mb-5">
            Простір, де можна бути собою
          </h1>
          <p class="text-lg leading-relaxed text-theme-text-secondary">
            Місце для відновлення, творчості, спілкування та уважного ставлення
            до себе. Без поспіху, оцінювання та необхідності відповідати чиїмось очікуванням.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {directions.map((direction) => (
            <article class="bg-theme-surface rounded-2xl p-7 border border-theme-border shadow-sm">
              <div class="w-12 h-12 rounded-xl bg-theme-primary-lighter/20 flex items-center justify-center text-theme-primary text-xl mb-6">
                ✦
              </div>
              <h2 class="text-xl font-bold text-theme-text-primary mb-3">
                {direction.title}
              </h2>
              <p class="text-base leading-relaxed text-theme-text-secondary">
                {direction.description}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <CallToActionSection />
</Layout>
